{
  "name": "temp-app",
  "version": "0.1.0",
  "type": "module",
  "pnpm": {
    "overrides": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "private": true,
  "scripts": {
    "dev": "next dev --webpack | pino-pretty",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .tsx,.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed:e2e": "tsx scripts/seed-e2e.ts",
    "seed:composers": "tsx src/infrastructure/composer/cli/seed-composers.ts",
    "sync:content:r2": "tsx scripts/sync-r2.ts",
    "seed:works": "tsx src/infrastructure/work/cli/seed-works.ts",
    "validate:composers": "tsx src/infrastructure/composer/cli/validate-composers.ts",
    "validate:works": "tsx src/infrastructure/work/cli/validate-works.ts",
    "validate:zap-rules": "tsx scripts/validate-zap-rules.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@libsql/client": "^0.17.0",
    "@sentry/nextjs": "^10.39.0",
    "@supabase/supabase-js": "^2.95.3",
    "@swc/helpers": "^0.5.18",
    "@t3-oss/env-nextjs": "^0.13.10",
    "abcjs": "^6.6.2",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.34.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "import-in-the-middle": "^3.0.0",
    "mime-types": "^3.0.2",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.30",
    "next-intl": "^4.8.3",
    "next-mdx-remote": "^6.0.0",
    "p-limit": "^7.3.0",
    "pino": "^10.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-youtube": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "require-in-the-middle": "^8.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "use-debounce": "^10.1.0",
    "uuidv7": "^1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/glob": "^9.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.2.3",
    "@types/p-limit": "^2.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-youtube": "^7.10.0",
    "@vitejs/plugin-react": "^5.1.2",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.0",
    "vitest": "^4.0.18"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css}": [
      "prettier --write"
    ],
    ".zap/zap-rules.conf": [
      "pnpm run validate:zap-rules"
    ]
  }
}
